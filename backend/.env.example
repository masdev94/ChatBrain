# ──────────────────────────────────────────────────────────────────────────
# ChatBrain backend environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# ──────────────────────────────────────────────────────────────────────────

# Supabase project (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection URL. Used ONLY by `npm run db:push` to apply
# migrations from supabase/migrations/ — never read by the FastAPI app
# itself (which talks to Supabase via the REST/Storage APIs above).
#
# Where to get it: Supabase Dashboard → your project → Connect →
#   Direct connection (or Session pooler if your network blocks 5432).
# Replace [YOUR-PASSWORD] with the password from
#   Project Settings → Database → Database password.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=gpt-4o-mini

# CORS: the origins allowed to call this API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Chunking
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=150

# Retrieval
RETRIEVAL_TOP_K=8
